# MongoDB Atlas
# Si tu red bloquea/rompe las consultas DNS SRV (pasa en algunas VPN/routers),
# usa el formato estandar con los 3 hosts del shard en vez de mongodb+srv://
# (lo obtienes en Atlas: Connect > Drivers, y si falla mongodb+srv, prueba con
# "Connect with legacy mongo shell" o arma el string con los hosts del SRV).
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/cinerejon?retryWrites=true&w=majority

# Auth
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_EMAIL=admin@cinerejon.com
ADMIN_PASSWORD=cambia-esta-contrasena

# SMTP (cualquier proveedor: Gmail, SendGrid, SES, Mailtrap, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=password
FROM_EMAIL="CineRejon <no-reply@cinerejon.com>"

# Dominio publico del sitio (se hornea en cada QR impreso)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
